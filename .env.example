# Kopiera filen till .env och fyll i värdena. Citattecken rekommenderas.
TIMEEDIT_USERNAME="liuid@liu.se"
TIMEEDIT_PASSWORD="byt-mig"
TIMEEDIT_PURPOSE="Grupparbete"

# Normal körning är headless. --setup-session tvingar alltid synligt läge.
TIMEEDIT_HEADLESS=true
TIMEEDIT_TIMEOUT_MS=20000
TIMEEDIT_STATE_FILE=.timeedit-state.json

# Om LiU:s TimeEdit-gränssnitt ändras kan exakta CSS-selektorer anges här.
# Hämta dem med Playwright Inspector: PWDEBUG=1 python timeedit_booker.py
# TIMEEDIT_DATE_INPUT_SELECTOR='input[type="date"]'
# TIMEEDIT_AVAILABLE_SELECTOR='button.available'
# TIMEEDIT_PURPOSE_SELECTOR='textarea[name="purpose"]'
# TIMEEDIT_BOOK_BUTTON_SELECTOR='button[type="submit"]'
# TIMEEDIT_SUCCESS_SELECTOR='[role="status"]'
